  <operation name="AlarmMgr_ctor" type="void" visibility="0x00" properties="0x00">
   <code>AlarmMgr *me = &amp;AlarmMgr_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;AlarmMgr_initial));

 for (int i = 0; i &lt; MAX_ALARMS; ++i) {
    me-&gt;alarms[i].enabled = false;
}

// 2. Cria alarmes de teste (ex: às 08:00 e 12:00 todos os dias)
me-&gt;alarms[0].id = 1;
me-&gt;alarms[0].hour = 12;
me-&gt;alarms[0].minute = 1;
me-&gt;alarms[0].weekday_mask = 0x7F; // 0x7F = todos os 7 dias
me-&gt;alarms[0].medicine_id = 101;
me-&gt;alarms[0].enabled = true;

me-&gt;alarms[1].id = 2;
me-&gt;alarms[1].hour = 12;
me-&gt;alarms[1].minute = 0;
me-&gt;alarms[1].weekday_mask = 0x7F;
me-&gt;alarms[1].medicine_id = 102;
me-&gt;alarms[1].enabled = false;


</code>
  </operation>
  <attribute name="AO_AlarmMgr" type="QActive* const" visibility="0x00" properties="0x00">
   <code>= Q_ACTIVE_UPCAST(&amp;AlarmMgr_inst);</code>
  </attribute>
  <attribute name="AO_NotificationMgr" type="QActive* const" visibility="0x00" properties="0x00">
