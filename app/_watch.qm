       <tran trig="MODE">
        <action>me-&gt;curr_mode = (me-&gt;curr_mode + 1) % 3;</action>
        <tran_glyph conn="171,94,3,-1,10">
         <action box="0,-2,10,2"/>
        </tran_glyph>
       </tran>
       <tran trig="TOGGLE">
        <action>switch(me-&gt;curr_mode) {
    case 0: 
        me-&gt;hour = (me-&gt;hour &lt; 23) ? me-&gt;hour + 1 : 0; 
        break;
    case 1: 
        me-&gt;minute = (me-&gt;minute &lt; 59) ? me-&gt;minute + 1 : 0; 
        break;
    case 2: 
        me-&gt;second = (me-&gt;second &lt; 59) ? me-&gt;second += 1 : 0;
    case 3:
        me-&gt;time_format = !me-&gt;time_format;
}
char buf[10];
//if (me-&gt;time_format == 0) // 12h
//    snprintf(buf, sizeof(buf), &quot;%02d:%02d:%02d 12h&quot;, me-&gt;hour, me-&gt;minute, me-&gt;second);
