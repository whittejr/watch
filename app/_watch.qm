  </attribute>
  <operation name="NotificationMgr_ctor" type="void" visibility="0x00" properties="0x00">
   <code>NotificationMgr *me = &amp;NotificationMgr_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;NotificationMgr_initial));

QTimeEvt_ctorX(&amp;me-&gt;alertTimer, &amp;me-&gt;super, ALARM_TIMEOUT_SIG, 0U);</code>
  </operation>
