  <class name="AlarmMgr" superclass="qpc::QActive">
   <attribute name="alarms[MAX_ALARMS]" type="Alarm" visibility="0x02" properties="0x00"/>
   <attribute name="inst" type="AlarmMgr" visibility="0x00" properties="0x01"/>
   <operation name="reschedule" type="void" visibility="0x00" properties="0x00">
    <code>bsp_datetime_t now;
bsp_get_time(&amp;now);

uint32_t now_mins = (uint32_t)now.hour * 60 + now.minute;
uint8_t current_wday = 7;

uint32_t shortest_diff = UINT32_MAX;
Alarm const *next_alarm = NULL;

for (int i = 0; i &lt; MAX_ALARMS; ++i) {
    if (!me-&gt;alarms[i].enabled) {
        continue;
    }

    uint32_t alarm_mins = (uint32_t)me-&gt;alarms[i].hour * 60 + me-&gt;alarms[i].minute;

    for (uint8_t day_offset = 0; day_offset &lt; 7; ++day_offset) {
        uint8_t target_wday = (current_wday + day_offset) % 7;

        if (me-&gt;alarms[i].weekday_mask &amp; (1U &lt;&lt; target_wday)) {
            uint32_t diff_mins;

            if (day_offset == 0) {
                if (alarm_mins &gt; now_mins) {
                    diff_mins = alarm_mins - now_mins;
                } else {
                    continue;
                }
            } else {
                diff_mins = (day_offset * 1440U + alarm_mins) - now_mins;
            }

            if (diff_mins &lt; shortest_diff) {
                shortest_diff = diff_mins;
                next_alarm = &amp;me-&gt;alarms[i];
            }
            break;
        }
    }
}

if (next_alarm != NULL) {
    rtc_set_alarm(next_alarm-&gt;hour, next_alarm-&gt;minute, 0);
} else {
    rtc_cancel_alarm();
}</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action>(void)par;
QActive_subscribe(&amp;me-&gt;super, ADD_ALARM_SIG);
QActive_subscribe(&amp;me-&gt;super, REMOVE_ALARM_SIG);
QActive_subscribe(&amp;me-&gt;super, TOGGLE_ALARM_SIG);
QActive_subscribe(&amp;me-&gt;super, TIME_CHANGED_SIG);</action>
     <initial_glyph conn="6,5,5,0,8,4">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="active">
     <entry>AlarmMgr_reschedule(me);</entry>
     <tran trig="RTC_ALARM">
      <action>bsp_datetime_t now;
bsp_get_time(&amp;now);

// Avisa quem precisa saber (GuiMgr e NotificationMgr)
for (int i = 0; i &lt; MAX_ALARMS; ++i) {
    if (me-&gt;alarms[i].enabled &amp;&amp;
        me-&gt;alarms[i].hour == now.hour &amp;&amp;
        me-&gt;alarms[i].minute == now.minute) {

        MedicineAlarmEvt *evt = Q_NEW(MedicineAlarmEvt, MEDICINE_ALARM_SIG);
        evt-&gt;medicine_id = me-&gt;alarms[i].medicine_id;
        QF_PUBLISH(&amp;evt-&gt;super, me);
    }
}
AlarmMgr_reschedule(me);</action>
      <tran_glyph conn="5,27,3,-1,11">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="ADD_ALARM, REMOVE_ALARM, TOGGLE_ALARM, TIME_CHANGED">
      <action>AlarmMgr_reschedule(me);</action>
      <tran_glyph conn="5,37,3,-1,11">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="5,9,78,52">
      <entry box="1,2,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="87,66"/>
