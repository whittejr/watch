 <package name="App" stereotype="0x00">
  <operation name="GuiMgr_ctor" type="void" visibility="0x00" properties="0x00">
   <code>GuiMgr *me = &amp;GuiMgr_inst;
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;GuiMgr_initial));
QTimeEvt_ctorX(&amp;me-&gt;timeEvt0, &amp;me-&gt;super, TICK_SIG, 0U);</code>
  </operation>
  <attribute name="AppSignals" type="enum" visibility="0x04" properties="0x00">
   <code>{
    TICK_SIG = Q_USER_SIG, // time tick event
    ENTER_SIG,
    MODE_SIG,
    BACK_SIG,
    TOGGLE_SIG,

    RTC_ALARM_SIG,
    ADD_ALARM_SIG,
    REMOVE_ALARM_SIG,
    TOGGLE_ALARM_SIG,
    TIME_CHANGED_SIG,
    MEDICINE_ALARM_SIG,

    SNOOZE_SIG,
    DISMISS_SIG,
    

    MAX_PUB_SIG,

    ALARM_TIMEOUT_SIG,
    SNOOZE_TIMEOUT_SIG,
    TIMEOUT_SIG,
    MAX_SIG
};</code>
  </attribute>
  <attribute name="AO_GuiMgr" type="QActive* const" visibility="0x00" properties="0x00">
   <code>= Q_ACTIVE_UPCAST(&amp;GuiMgr_inst);</code>
  </attribute>
